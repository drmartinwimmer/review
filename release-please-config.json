{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "code-review-workspace",
      "components": [
        "code-review-configure-lints",
        "code-review-coverage",
        "code-review-check",
        "code-review"
      ]
    }
  ],
  "packages": {
    "crates/configure-lints": {
      "release-type": "rust",
      "package-name": "code-review-configure-lints",
      "component": "code-review-configure-lints",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.toml",
          "jsonpath": "$.workspace.dependencies['code-review-configure-lints'].version"
        }
      ]
    },
    "crates/coverage": {
      "release-type": "rust",
      "package-name": "code-review-coverage",
      "component": "code-review-coverage",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.toml",
          "jsonpath": "$.workspace.dependencies['code-review-coverage'].version"
        }
      ]
    },
    "crates/check": {
      "release-type": "rust",
      "package-name": "code-review-check",
      "component": "code-review-check",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.toml",
          "jsonpath": "$.workspace.dependencies['code-review-check'].version"
        }
      ]
    },
    "crates/code-review": {
      "release-type": "rust",
      "package-name": "code-review",
      "component": "code-review",
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "generic",
          "path": "/flake.nix"
        }
      ]
    }
  }
}
